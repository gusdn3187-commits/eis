/**
 * ④ 규제 적용 판정 실행
 * 회사프로파일을 규칙표에 대조해 규제대장을 생성/갱신합니다.
 */
function 규제판정_실행() {
  const p = 프로파일_읽기();
  const 오늘 = new Date();
  const 결산월 = Number(String(p['결산월'] || '12').replace(/\D/g, '')) || 12;

  const 헤더 = ['규제ID', '구분', '규제명', '근거', '임계값', '적용', '판정근거',
                '시행·기한', '착수권장', '필요조치', '담당', '검증상태', '상태', '최종확인'];
  const sh = 시트가져오기(시트.규제대장, 헤더);

  // 사용자가 직접 관리하는 '상태' 열은 보존합니다.
  const 기존상태 = {};
  if (sh.getLastRow() > 1) {
    sh.getRange(2, 1, sh.getLastRow() - 1, 헤더.length).getValues()
      .forEach(r => { if (r[0]) 기존상태[r[0]] = r[12]; });
  }

  const 행들 = 규제규칙.map(r => {
    let 적용, 판정근거;
    try {
      적용 = r.판정(p);
    } catch (e) {
      적용 = null;
    }

    const a = 자산별도(p);
    if (적용 === null)       { 판정근거 = a === null ? '자산총액 미확인 — 프로파일 확인 필요' : '수동 확인 필요'; }
    else if (적용 === true)  { 판정근거 = a !== null ? `자산총액(별도) ${억원(a)}` : '상장회사 해당'; }
    else                     { 판정근거 = a !== null ? `자산총액(별도) ${억원(a)} — 임계값 미달` : '해당 없음'; }

    let 시행 = '', 착수 = '';
    if (r.시행일계산) {
      const s = r.시행일계산(p);
      if (s && s.시행연도) {
        시행 = `${s.시행연도} 사업연도 (${s.설명})`;
        // 감사보고서는 통상 다음 해 정기주총 전 → 착수는 2년 전 권장
        착수 = `${s.시행연도 - 2}년 착수 권장`;
      } else if (s) {
        시행 = s.설명;
      }
    }

    const 적용표시 = 적용 === true ? '✅ 적용' : 적용 === false ? '— 미적용' : '❓ 확인필요';
    const 검증표시 = r.검증 === '확인' ? '✅ 확인됨' : '⚠️ 미검증 — 법제처 대조 필요';

    return [r.id, r.구분, r.규제명, r.근거, r.임계값, 적용표시, 판정근거,
            시행, 착수, r.조치, r.담당, 검증표시,
            기존상태[r.id] || (적용 === true ? '준비전' : ''), 오늘];
  });

  if (sh.getLastRow() > 1) sh.getRange(2, 1, sh.getLastRow() - 1, 헤더.length).clearContent();
  sh.getRange(2, 1, 행들.length, 헤더.length).setValues(행들);
  sh.autoResizeColumns(1, 헤더.length);
  서식적용_(sh, 행들.length, 헤더.length);

  const 적용수 = 행들.filter(r => r[5] === '✅ 적용').length;
  const 확인필요 = 행들.filter(r => r[5] === '❓ 확인필요').length;
  const 미검증 = 행들.filter(r => String(r[11]).indexOf('미검증') >= 0).length;

  const 요약 = [
    `총 ${행들.length}건 판정`,
    `  적용: ${적용수}건`,
    `  확인필요: ${확인필요}건`,
    `  미검증(법제처 대조 필요): ${미검증}건`,
    '',
    '⚠️ 이 판정은 초안입니다.',
    '[검증상태] 열이 "미검증"인 항목은 반드시 조문 원문을 대조하세요.',
    `(결산월 ${결산월}월 기준으로 기한을 계산합니다)`,
  ].join('\n');

  Logger.log(요약);
  try { SpreadsheetApp.getUi().alert('규제 적용 판정 완료\n\n' + 요약); } catch (e) {}
  return 요약;
}

// ─────────────────────────────────────────────
// 판정 보조 함수
// ─────────────────────────────────────────────

function 자산별도(p) {
  const v = 숫자로(p['자산총액(별도)']);
  return (v === null || v === 0) ? null : v;
}

function 자산연결(p) {
  const v = 숫자로(p['자산총액(연결)']);
  return (v === null || v === 0) ? null : v;
}

function 상장사인가(p) {
  const m = String(p['시장구분'] || '');
  if (!m) return null;
  return m.indexOf('유가') >= 0 || m.indexOf('코스피') >= 0 || m.indexOf('코스닥') >= 0;
}

function 예아니오(v) {
  const s = String(v || '').trim().toUpperCase();
  if (['Y', 'YES', 'O', '예', 'TRUE'].indexOf(s) >= 0) return true;
  if (['N', 'NO', 'X', '아니오', 'FALSE'].indexOf(s) >= 0) return false;
  return null;
}

/** 규제대장에 색상·조건부서식을 적용합니다. */
function 서식적용_(sh, 행수, 열수) {
  if (행수 < 1) return;
  const 범위 = sh.getRange(2, 1, 행수, 열수);

  const 규칙 = [
    SpreadsheetApp.newConditionalFormatRule()
      .whenTextEqualTo('✅ 적용').setBackground('#e6f4ea')
      .setRanges([sh.getRange(2, 6, 행수, 1)]).build(),
    SpreadsheetApp.newConditionalFormatRule()
      .whenTextEqualTo('❓ 확인필요').setBackground('#fff3cd')
      .setRanges([sh.getRange(2, 6, 행수, 1)]).build(),
    SpreadsheetApp.newConditionalFormatRule()
      .whenTextContains('미검증').setBackground('#fce8e6')
      .setRanges([sh.getRange(2, 12, 행수, 1)]).build(),
  ];
  sh.setConditionalFormatRules(규칙);
  범위.setVerticalAlignment('top').setWrap(false);
}
