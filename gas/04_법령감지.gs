/**
 * OC 승인 후 가장 먼저 실행하세요.
 * 법제처 API의 실제 응답을 그대로 로그에 출력합니다.
 * 이 출력을 보고 파싱 로직을 확정합니다.
 */
function 법제처_응답탐색() {
  const oc = 키('LAW_OC');
  const 시도 = [
    { 설명: '법령 목록 (JSON)',   url: `${API.법제처_목록}?OC=${oc}&target=law&type=JSON&query=${encodeURIComponent('상법')}&display=3` },
    { 설명: '행정규칙 목록 (JSON)', url: `${API.법제처_목록}?OC=${oc}&target=admrul&type=JSON&query=${encodeURIComponent('증권의 발행')}&display=3` },
  ];

  시도.forEach(t => {
    Logger.log('════════ %s ════════', t.설명);
    Logger.log('URL: %s', t.url);
    try {
      const res = UrlFetchApp.fetch(t.url, {
        muteHttpExceptions: true,
        headers: { 'User-Agent': UA },
      });
      Logger.log('HTTP %s', res.getResponseCode());
      // 응답 앞부분을 원문 그대로 봅니다 (구조 파악용)
      Logger.log(res.getContentText().slice(0, 3000));
    } catch (e) {
      Logger.log('실패: %s', e);
    }
  });

  Logger.log('\n※ 위 출력을 그대로 복사해 주시면 파싱 로직을 확정하겠습니다.');
}

